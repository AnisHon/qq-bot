APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# Optional NVIDIA NIM provider.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_TIMEOUT=120

# Optional Alibaba DashScope compatible provider.
QWEN_API_KEY=
QWEN_BASE_URL=https://ws-mgclbjrh7zrdte82.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_TIMEOUT=120

# Optional New API / OpenAI-compatible relay provider.
NEWAPI_API_KEY=
NEWAPI_BASE_URL=https://api.shirosora.cn/v1
NEWAPI_MODEL=gpt-5.4-mini
NEWAPI_TIMEOUT=180

# Optional CCTQ New API relay. Model IDs overlap another relay, so use cctq/<model-id> aliases.
CCTQ_API_KEY=
CCTQ_BASE_URL=https://www.cctq.ai/v1
CCTQ_MODEL=gpt-6-luna
CCTQ_TIMEOUT=180
DEFAULT_MODEL_PROVIDER=nvidia

BOT_TRIGGER_MODE=at
BOT_PREFIX=/bot
BOT_QQ_ID=
BOT_ADMIN_QQ_LIST=
BOT_DEFAULT_NAME=胖虎
BOT_NAME_CACHE_SECONDS=3600

SQLITE_PATH=data/bot.db
MESSAGE_HISTORY_LIMIT=80
CONTEXT_RECENT_MESSAGE_LIMIT=8
SUMMARY_TRIGGER_MESSAGE_COUNT=18
SUMMARY_MAX_CHARS=1200
MEMORY_QUERY_LIMIT=10
RAG_ENABLED=true
RAG_DOCUMENT_NAME=sfm
RAG_QUERY_LIMIT=4
QQ_MESSAGE_MAX_CHARS=850
REPLY_NOTICE_DELAY=3.0
NETWORK_TOOL_TIMEOUT=10
NETWORK_PROXY_URL=http://127.0.0.1:7890
GITHUB_TOKEN=

# Optional Tavily Web Research provider. Set the key only in a private .env or
# service environment; the repository .env.example intentionally stays blank.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_CALLS_PER_REQUEST=3
WEB_EXTRACT_MAX_CALLS_PER_REQUEST=3
WEB_SEARCH_CACHE_TTL=1800
WEB_NEWS_CACHE_TTL=300
WEB_STABLE_CACHE_TTL=21600
WEB_RELEASE_CACHE_TTL=600
WEB_EXTRACT_CACHE_TTL=3600
WEB_CACHE_MAX_ENTRIES=256
WEB_CACHE_MAX_BYTES=8388608
WEB_GLOBAL_CALLS_PER_MINUTE=60
WEB_MAX_CONCURRENT_REQUESTS=4
WEB_EXTRACT_MAX_CHARS=12000

AGENT_TOOLS_ENABLED=true
AGENT_TOOL_MAX_ROUNDS=8
AGENT_TOOL_MAX_CALLS_PER_ROUND=10
AGENT_TOOL_MAX_TOTAL_CALLS=36
AGENT_TOTAL_TIMEOUT=110
AGENT_TOOL_RESULTS_MAX_CHARS=16000
SCHEDULER_POLL_INTERVAL=10

NATCAPQQ_API_BASE_URL=http://127.0.0.1:3000
NATCAPQQ_API_TOKEN=
NATCAPQQ_CALLBACK_TOKEN=

HTTP_TIMEOUT=30
MINECRAFT_TIMEOUT=15
